# Data path - Linux: leave commented (defaults to /srv/docker)
# macOS: uncomment and set your home path
#DATA_DIR=/Users/yourusername/srv/docker

# Image / port
RALLLY_VERSION=4.16.3
RALLLY_PORT=3032

# Public URL — must match the hostname your reverse proxy serves on
NEXT_PUBLIC_BASE_URL=https://poll.example.com

# Secrets (generate with the commands shown)
# openssl rand -base64 32
SECRET_PASSWORD=change-me-to-random-32-chars
# openssl rand -hex 24
POSTGRES_PASSWORD=change-me-postgres
# openssl rand -hex 32  (64 hex chars = 32 bytes, required by garage)
GARAGE_RPC_SECRET=change-me-64-hex-chars
# openssl rand -hex 16
S3_ACCESS_KEY_ID=change-me-access-key
# openssl rand -hex 32
S3_SECRET_ACCESS_KEY=change-me-secret-key

# App emails
SUPPORT_EMAIL=admin@example.com
# NOREPLY_EMAIL=noreply@example.com
# First user to sign in with this address can claim admin at /control-panel
INITIAL_ADMIN_EMAIL=admin@example.com

# SMTP (required for sign-in magic links and notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PWD=

# Access control (optional)
# ALLOWED_EMAILS=*@example.com
