# Data paths - Linux: leave commented (defaults to /srv/docker)
# macOS: uncomment and set your home path
#DATA_DIR=/Users/yourusername/srv/docker
#BACKUP_DIR=/Users/yourusername/srv/backups

# Required
AFFINE_PORT=3010
AFFINE_REVISION=0.27.0

# Database
DB_USERNAME=affine
DB_PASSWORD=your-secure-password-here
DB_DATABASE=affinedb

# AFFiNE mailer settings live in config.json since 0.27 (upstream dropped the
# MAILER_* env vars). Copy config.json.example to
# ${DATA_DIR:-/srv/docker}/affine/config/config.json and edit the SMTP block.

# SMTP relay (Postfix) config — this container still uses env vars.
# The relay forwards mail from AFFiNE to your real mail provider with proper TLS.
SMTP_RELAY_HOST=smtp.gmail.com
SMTP_RELAY_PORT=587
MAILER_USER=your-email@example.com
MAILER_PASSWORD=your-app-password-here
MAIL_DOMAIN=example.com

# Optional
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
